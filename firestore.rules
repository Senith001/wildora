rules_version = '2';

// DEVELOPMENT-STAGE Firestore Security Rules for Wildora
//
// IMPORTANT: These rules are for DEVELOPMENT ONLY and expire on 2026-12-31.
// 
// Before production deployment, these rules MUST be replaced with:
// 1. Authentication requirement (Firebase Auth integration)
// 2. Role-based access control for:
//    - Rangers: read/write animals, alerts; read highRiskZones
//    - Community Liaison Officers: read animals, alerts, highRiskZones
//    - Park Managers: full access to all collections
// 
// The current time-boxed rules allow unrestricted access to the three core
// collections (animals, highRiskZones, alerts) until the expiration date,
// after which all access will be denied by default.

service cloud.firestore {
  match /databases/{database}/documents {
    // Development access to animals collection (expires 2026-12-31)
    match /animals/{animalId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    
    // Development access to highRiskZones collection (expires 2026-12-31)
    match /highRiskZones/{zoneId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    
    // Development access to alerts collection (expires 2026-12-31)
    match /alerts/{alertId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
      
      // Development access to alert recipients subcollection (expires 2026-12-31)
      match /recipients/{officerId} {
        allow read, write: if request.time < timestamp.date(2026, 12, 31);
      }
    }
    
    // Development access to officers collection (expires 2026-12-31)
    match /officers/{officerId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    
    // Development access to dutyRoster collection (expires 2026-12-31)
    match /dutyRoster/{date} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    
    // Development access to userPreferences collection (expires 2026-12-31)
    match /userPreferences/{userId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    
    // NOTE: Production deployment requires per-role authentication:
    // - Rangers: read/write animals, alerts; read highRiskZones, officers, dutyRoster
    // - CLOs: read animals, alerts, highRiskZones; read officers
    // - Users: read/write own userPreferences only
    
    // Conflict reporting only; other collections retain their existing policy.
    function conflictClo() {
      return request.auth != null && request.auth.token.get('role', '') == 'clo';
    }
    match /conflictReports/{reportId} {
      allow read: if request.auth != null && ((conflictClo() &&
        (!request.auth.token.get('isDemo', false) || resource.data.get('isDemo', false))) ||
        resource.data.get('isDemo', false) == true ||
        resource.data.get('reporterId', '') == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.id == reportId &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.get('isDemo', false) == request.auth.token.get('isDemo', false) &&
        request.resource.data.syncStatus == 'synced' &&
        request.resource.data.reportStatus == 'submitted' &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 500 &&
        request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
        request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180 &&
        request.resource.data.locationDescription is string && request.resource.data.locationDescription.size() > 0 &&
        request.resource.data.wildlifeType in ['elephant', 'leopard', 'wildBoar', 'other'] &&
        request.resource.data.conflictType in ['cropRaiding', 'animalSighting', 'propertyDamage', 'threatToPeople', 'other'];
      allow update: if conflictClo() &&
        (!request.auth.token.get('isDemo', false) || resource.data.get('isDemo', false)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportStatus', 'reviewedBy', 'reviewedAt', 'resolvedAt', 'responseNotes', 'updatedAt']) &&
        ((resource.data.reportStatus == 'submitted' && request.resource.data.reportStatus == 'underReview') ||
         (resource.data.reportStatus == 'underReview' && request.resource.data.reportStatus == 'resolved' &&
          request.resource.data.responseNotes is string && request.resource.data.responseNotes.size() > 0));
      allow delete: if false;
    }


    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}